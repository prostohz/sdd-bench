{
  "id": "speckit",
  "name": "Spec Kit",
  "setup": "setup.sh",
  "prompt": "prompt.md",
  "specPaths": ["specs"],
  "allowHosts": [
    "astral.sh",
    "*.astral.sh",
    "pypi.org",
    "files.pythonhosted.org",
    "github.com",
    "api.github.com",
    "codeload.github.com",
    "*.githubusercontent.com"
  ],
  "mounts": {},
  "versionProbe": "specify version 2>&1 | grep -Eo '[0-9]+[.][0-9]+[.][0-9]+' | head -1"
}
