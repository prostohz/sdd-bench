{
  "id": "bmad",
  "name": "BMad Method",
  "setup": "setup.sh",
  "prompts": {
    "full": "prompt.md",
    "spec": "prompt-spec.md"
  },
  "specPaths": [
    "docs"
  ],
  "allowHosts": [
    "registry.npmjs.org",
    "*.npmjs.org",
    "github.com",
    "api.github.com",
    "codeload.github.com",
    "*.githubusercontent.com"
  ],
  "mounts": {},
  "versionProbe": "grep -m1 'version:' \"$(git rev-parse --show-toplevel)/_bmad/_config/manifest.yaml\""
}
