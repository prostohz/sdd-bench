{
  "name": "sdd-bench",
  "version": "0.1.0",
  "description": "A benchmark for spec-driven development tools: tasks, runs and the metrics they are compared by",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "sdd-bench": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "tsc",
    "site": "npm run build && node dist/src/site/export.js",
    "serve": "trap 'kill 0' EXIT INT TERM; tsc --watch --preserveWatchOutput & node --watch dist/src/cli.js serve",
    "test": "tsc && node --test dist/test/*.test.js",
    "validate": "tsc && node dist/src/cli.js validate"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  }
}
